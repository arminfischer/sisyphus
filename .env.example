# ── Required ─────────────────────────────────────────────────────────────────
# Replace with your laptop's actual LAN IP.
OLLAMA_HOST=http://192.168.2.100:11434

# Gmail account created for the agent.
# Google Account → Security → 2-Step Verification → App Passwords → generate one.
GMAIL_USER=agent.sisyphus@gmail.com
GMAIL_APP_PASSWORD=

# Where to forward reports and feedback requests
NOTIFY_EMAIL=misantropolis@gmail.com

# ── Optional overrides (defaults shown, defined in agent/config.py) ───────────
# OLLAMA_MODEL=qwen3:8b
# OLLAMA_EMBED_MODEL=nomic-embed-text
# OMNI_MCP_URL=http://192.168.2.117:9090
# DASHBOARD_PORT=7070
# RESEARCH_INTERVAL_MINUTES=120
# INBOX_CHECK_INTERVAL_MINUTES=15
# DAILY_REPORT_HOUR=8

# ── Docker only (data paths) ──────────────────────────────────────────────────
# Locally defaults to ./data/ automatically — no need to set.
# In Docker these are set via ENV in the Dockerfile; uncomment only to override:
# DATA_DIR=/data
# DB_PATH=/data/sisyphus.db
# CHROMA_PATH=/data/chroma
# GOALS_FILE=/data/goals.md
