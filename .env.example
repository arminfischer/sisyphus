# ── LLM (Ollama running on your laptop) ──────────────────────────────────────
# Replace 192.168.2.xxx with your laptop's actual LAN IP.
OLLAMA_HOST=http://192.168.2.100:11434
OLLAMA_MODEL=qwen2.5:14b-instruct-q4_K_M
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── OmniMCP ───────────────────────────────────────────────────────────────────
OMNI_MCP_URL=http://192.168.2.117:9090

# ── Email ─────────────────────────────────────────────────────────────────────
# Create a dedicated Gmail account for the agent.
# Then: Google Account → Security → App Passwords → generate one.
GMAIL_USER=sisyphus.agent@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Where to forward reports and feedback requests
NOTIFY_EMAIL=armin.h.g.fischer@proton.me

# ── Dashboard ─────────────────────────────────────────────────────────────────
DASHBOARD_PORT=8080

# ── Timing ────────────────────────────────────────────────────────────────────
# How often to run a research cycle (minutes)
RESEARCH_INTERVAL_MINUTES=120
# How often to check inbox for feedback (minutes)
INBOX_CHECK_INTERVAL_MINUTES=15
# Hour of day (UTC) to send the daily report
DAILY_REPORT_HOUR=8
